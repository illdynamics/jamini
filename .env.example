# ── Required ──────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── Model selection ───────────────────────────────────────────────────
# User-facing model names (the bridge maps to actual DeepSeek models):
#   v4-flash          → deepseek-v4-flash (non-thinking)
#   v4-flash-thinking → deepseek-v4-flash (thinking)
#   v4-pro            → deepseek-v4-pro (non-thinking)
#   v4-pro-thinking   → deepseek-v4-pro (thinking)
JAMINI_MODEL=v4-flash-thinking
# JAMINI_THINKING=enabled|disabled  (auto-derived from model)
JAMINI_REASONING_EFFORT=high

# ── Bridge ────────────────────────────────────────────────────────────
# JAMINI_BRIDGE_PORT=7654
# JAMINI_BRIDGE_HOST=127.0.0.1
# JAMINI_BRIDGE_LOCAL_API_KEY=jamini-local-placeholder

# ── Jamini paths ──────────────────────────────────────────────────────
# JAMINI_HOME=~/.jamini
# GEMINI_CLI_HOME=~/.jamini/gemini-cli-home

# ── Optional power-ups ────────────────────────────────────────────────
# BRAVE_API_KEY=your-brave-search-key
# UNSTRUCTURED_API_KEY=your-unstructured-key

# ── Debug ─────────────────────────────────────────────────────────────
# JAMINI_DEBUG=1
# JAMINI_STREAM_IDLE_TIMEOUT_MS=600000
# JAMINI_REQUEST_MAX_RETRIES=2
